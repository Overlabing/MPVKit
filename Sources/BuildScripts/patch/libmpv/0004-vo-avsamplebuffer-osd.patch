+static void free_overlay_pixels(void *info, const void *data, size_t size)
+{
+    free((void *)data);
+}
+
+// Copy rc out of the (cache-owned, premultiplied BGRA) overlay into a new
+// CGImage (+1 reference), or NULL on failure.
+static CGImageRef make_overlay_image(struct mp_image *osd, struct mp_rect rc)
+{
+    int w = mp_rect_w(rc), h = mp_rect_h(rc);
+    if (w <= 0 || h <= 0)
+        return NULL;
+    size_t stride = (size_t)w * 4;
+    void *buf = malloc(stride * h);
+    if (!buf)
+        return NULL;
+    memcpy_pic(buf, mp_image_pixel_ptr(osd, 0, rc.x0, rc.y0), w * 4, h,
+               (int)stride, osd->stride[0]);
+
+    CGDataProviderRef prov =
+        CGDataProviderCreateWithData(NULL, buf, stride * h, free_overlay_pixels);
+    if (!prov) {
+        free(buf);
+        return NULL;
+    }
+    CGColorSpaceRef cs = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    CGImageRef img = CGImageCreate(w, h, 8, 32, stride, cs,
+                                   kCGBitmapByteOrder32Little |
+                                   kCGImageAlphaPremultipliedFirst,
+                                   prov, NULL, false, kCGRenderingIntentDefault);
+    if (cs)
+        CGColorSpaceRelease(cs);
+    CGDataProviderRelease(prov);
+    return img;
+}
+
+// Hand an overlay image (or NULL to clear) to the main thread. Consumes the
+// caller's reference on image.
+static void push_overlay(struct priv *p, CGImageRef image, CGRect rect, CGSize size)
+{
+    AVSBOverlay *ov = p->overlay; // retained by the block
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [ov showImage:image rect:rect osdSize:size];
+        if (image)
+            CGImageRelease(image);
+    });
+}
