+// Main-thread-only helper owning the overlay CALayer that shows the OSD image.
+// Every method must be called on the main queue (the VO thread dispatches
+// asynchronously, never synchronously, so a main thread blocked on mpv cannot
+// deadlock). The overlay is positioned inside the aspect-fitted video rect of
+// the parent layer and follows parent bounds changes via KVO.
+@interface AVSBOverlay : NSObject {
+    AVSampleBufferDisplayLayer *_parent; // retained
+    CALayer *_layer;                     // retained
+    CGRect _rect;                        // image placement, in OSD pixels
+    CGSize _osdSize;                     // OSD resolution (video display size)
+    BOOL _hasImage;
+    BOOL _attached;
+    BOOL _detached;
+}
+- (instancetype)initWithParent:(AVSampleBufferDisplayLayer *)parent;
+- (void)attach;
+- (void)detach;
+// image == NULL clears the overlay.
+- (void)showImage:(CGImageRef)image rect:(CGRect)rect osdSize:(CGSize)size;
+@end
+
+@implementation AVSBOverlay
+
+- (instancetype)initWithParent:(AVSampleBufferDisplayLayer *)parent
+{
+    self = [super init];
+    if (self) {
+        _parent = [parent retain];
+        _layer = [[CALayer alloc] init];
+        _layer.contentsGravity = kCAGravityResize;
+        _layer.opaque = NO;
+        _layer.hidden = YES;
+        _layer.zPosition = 1;
+    }
+    return self;
+}
+
+- (void)dealloc
+{
+    [_layer release];
+    [_parent release];
+    [super dealloc];
+}
+
+- (void)attach
+{
+    if (_attached || _detached)
+        return;
+    [_parent addSublayer:_layer];
+    [_parent addObserver:self forKeyPath:@"bounds" options:0 context:NULL];
+    _attached = YES;
+}
+
+- (void)detach
+{
+    if (_detached)
+        return;
+    _detached = YES;
+    if (_attached) {
+        [_parent removeObserver:self forKeyPath:@"bounds"];
+        _attached = NO;
+    }
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    _layer.contents = nil;
+    [_layer removeFromSuperlayer];
+    [CATransaction commit];
+}
+
+// Must be called inside a CATransaction with actions disabled.
+- (void)relayout
+{
+    CGRect b = _parent.bounds;
+    if (!_hasImage || _osdSize.width <= 0 || _osdSize.height <= 0 ||
+        b.size.width <= 0 || b.size.height <= 0)
+    {
+        _layer.hidden = YES;
+        return;
+    }
+
+    // Map OSD pixels to layer points the same way the layer maps the video.
+    CGFloat sx = b.size.width / _osdSize.width;
+    CGFloat sy = b.size.height / _osdSize.height;
+    CGFloat ox = b.origin.x, oy = b.origin.y;
+    NSString *gravity = _parent.videoGravity;
+    if (![gravity isEqualToString:AVLayerVideoGravityResize]) {
+        CGFloat s = [gravity isEqualToString:AVLayerVideoGravityResizeAspectFill]
+                    ? MAX(sx, sy) : MIN(sx, sy);
+        ox += (b.size.width - _osdSize.width * s) / 2;
+        oy += (b.size.height - _osdSize.height * s) / 2;
+        sx = sy = s;
+    }
+    _layer.frame = CGRectMake(ox + _rect.origin.x * sx, oy + _rect.origin.y * sy,
+                              _rect.size.width * sx, _rect.size.height * sy);
+    _layer.hidden = NO;
+}
+
+- (void)showImage:(CGImageRef)image rect:(CGRect)rect osdSize:(CGSize)size
+{
+    if (_detached)
+        return;
+    _hasImage = image != NULL;
+    _rect = rect;
+    _osdSize = size;
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    _layer.contents = image ? (id)image : nil;
+    [self relayout];
+    [CATransaction commit];
+}
+
+- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object
+                        change:(NSDictionary *)change context:(void *)context
+{
+    if (_detached || !_hasImage)
+        return;
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    [self relayout];
+    [CATransaction commit];
+}
+
+@end
