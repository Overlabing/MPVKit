+// Render OSD + subtitles for the frame with the given pts and update the
+// overlay layer if (and only if) something changed.
+static void draw_osd(struct vo *vo, double pts)
+{
+    struct priv *p = vo->priv;
+    if (!p->overlay || !vo->params || vo->dwidth <= 0 || vo->dheight <= 0)
+        return;
+
+    // The layer shows the video aspect-fitted in its bounds; render the OSD at
+    // the video display size without borders and let the overlay be scaled the
+    // same way.
+    struct mp_osd_res res = {
+        .w = vo->dwidth,
+        .h = vo->dheight,
+        .display_par = vo->monitor_par,
+    };
+
+    if (!p->osd_cache)
+        p->osd_cache = mp_draw_sub_alloc(p, vo->global);
+
+    struct sub_bitmap_list *sbs = osd_render(vo->osd, res, pts, 0, mp_draw_sub_formats);
+
+    struct mp_rect act_rc[1], mod_rc[64];
+    int num_act = 0, num_mod = 0;
+    struct mp_image *osd = mp_draw_sub_overlay(p->osd_cache, sbs,
+                                               act_rc, MP_ARRAY_SIZE(act_rc), &num_act,
+                                               mod_rc, MP_ARRAY_SIZE(mod_rc), &num_mod);
+    if (!osd) {
+        MP_WARN(vo, "Failed rendering OSD.\n");
+        goto done;
+    }
+
+    // num_mod == 0 guarantees the active region is unchanged. A resolution
+    // change must be pushed regardless (placement depends on it, and a new,
+    // empty overlay would otherwise not report the old one as modified).
+    bool res_changed = p->osd_w != res.w || p->osd_h != res.h;
+    if (!num_mod && !res_changed)
+        goto done;
+    p->osd_w = res.w;
+    p->osd_h = res.h;
+
+    CGSize size = CGSizeMake(res.w, res.h);
+    if (num_act > 0) {
+        struct mp_rect rc = act_rc[0];
+        CGImageRef img = make_overlay_image(osd, rc);
+        if (img) {
+            push_overlay(p, img, CGRectMake(rc.x0, rc.y0, mp_rect_w(rc), mp_rect_h(rc)), size);
+            p->osd_visible = true;
+            goto done;
+        }
+        MP_WARN(vo, "Failed to create OSD image.\n");
+    }
+    // Nothing to draw (or image creation failed): clear once.
+    if (p->osd_visible) {
+        push_overlay(p, NULL, CGRectZero, size);
+        p->osd_visible = false;
+    }
+
+done:
+    talloc_free(sbs);
+}
